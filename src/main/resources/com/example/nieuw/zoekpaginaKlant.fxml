<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.nieuw.ZoekpaginaController" style="-fx-background-color: #FFFFFF;">
    <children>
        <!-- Sidebar -->
        <VBox style="-fx-background-color: #0C003C;" prefWidth="200.0" AnchorPane.topAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.bottomAnchor="0.0">
            <children>
                <!-- Consistente tekst voor SafeNight Solutions -->
                <Label text="SafeNight Solutions" textFill="#E2871C"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-padding: 10px;" />
                <!-- Links in sidebar -->
                <Label text="Paal zoeken" textFill="WHITE"
                       style="-fx-font-size: 16px; -fx-padding: 10px; -fx-font-weight: normal;" />
            </children>
        </VBox>

        <!-- Oranje achtergrond -->
        <AnchorPane style="-fx-background-color: #E2871C;" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="200.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
            <!-- Main Content Section -->
            <VBox alignment="CENTER" spacing="20.0" AnchorPane.topAnchor="50.0" AnchorPane.leftAnchor="250.0"
                  AnchorPane.rightAnchor="250.0" style="-fx-background-color: #FFFFFF; -fx-padding: 30px;
               -fx-border-radius: 10px; -fx-background-radius: 10px;">
                <children>
                    <Label text="Paal zoeken" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0C003C;" />

                    <!-- Straat ListView -->
                    <Label text="Selecteer een straat:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0C003C;" />
                    <ListView fx:id="straatListView" onMouseClicked="#handleStraatClick" prefHeight="150.0"
                              prefWidth="300.0"
                              style="-fx-background-color: #FFFFFF; -fx-border-color: #0C003C; -fx-border-width: 2px;" />

                    <!-- Paal ListView -->
                    <Label text="Selecteer een paal:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0C003C;" />
                    <ListView fx:id="paalListView" onMouseClicked="#handlePaalClick" prefHeight="150.0"
                              prefWidth="300.0"
                              style="-fx-background-color: #FFFFFF; -fx-border-color: #0C003C; -fx-border-width: 2px;" />
                </children>
            </VBox>
        </AnchorPane>
    </children>
</AnchorPane>
